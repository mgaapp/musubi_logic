<div class="container">
  <h2>提出済みの申請一覧</h2>

  <%= link_to "新しく経費申請をする", new_request_path, class: "btn-primary" %>

  <table class="table-list">
    <thead>
      <tr>
        <th>申請日</th>
        <th>カテゴリ</th>
        <th>購入先</th>
        <th>税込金額</th>
        <th>ステータス</th>
        <th>詳細</th>
      </tr>
    </thead>
    <tbody>
      <% @requests.each do |request| %>
        <tr>
          <td><%= request.applied_at %></td>
          <td><%= request.category.name %></td> 
          <td><%= request.vendor %></td>
          <td><%= request.total_amount_incl_tax %> 円</td>
          <td>
            <span class="status-tag <%= request.status %>">
              <%= request.status %>
            </span>
          </td>
          <td><%= link_to "確認", request_path(request), class: "btn-sub" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
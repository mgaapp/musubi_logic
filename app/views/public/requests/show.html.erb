<div class="container">
  <h2>申請詳細</h2>

  <div class="detail-box">
    <p><strong>ステータス:</strong> <span class="status-tag"><%= @request.status %></span></p>
    <p><strong>申請日:</strong> <%= @request.applied_at %></p>
    <p><strong>カテゴリ:</strong> <%= @request.category.name %></p>
    <p><strong>購入先:</strong> <%= @request.vendor %></p>
    <p><strong>税抜単価:</strong> <%= @request.unit_price_excl_tax %> 円</p>
    <p><strong>数量:</strong> <%= @request.quantity %></p>
    <p><strong>消費税率:</strong> <%= @request.tax_rate %> %</p>
    <p><strong>税込金額:</strong> <%= @request.total_amount_incl_tax %> 円</p>
    <p><strong>領収書URL:</strong> <%= link_to "領収書を確認する", @request.receipt_url, target: "_blank" %></p>
  </div>

  <div class="form-actions">
    <%= link_to "一覧に戻る", requests_path, class: "btn-cancel" %>
  </div>
</div>
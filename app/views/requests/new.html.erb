<div class="container">
  <div class="row">
    <div class="col-md-9">
      <h2>新規経費申請</h2>
    </div>
  </div>

  <% if @request.errors.any? %>
    <div class="row">
      <div class="col-md-12 alert alert-danger">
        <h4><%= @request.errors.count %>件のエラーが発生しました</h4>
        <ul>
          <% @request.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-3"></div> 
    <div class="col-md-9"> 
      <div class="p-3 bg-warning bg-opacity-10 rounded border">
        二重買いを防ぐため、新しい申請の前に 
        <%= link_to "【貯蔵品棚卸一覧】", inventories_path, class: "fw-bold text-primary text-decoration-none" %> 
        で社内在庫を確認してください。
      </div>
    </div>
  </div>

  <hr>

  <%= form_with model: @request, url: requests_path, local: true do |f| %>
    <div class="row">

      <div class="col-md-3 text-end text-primary mb-3">
        <strong><%= f.label :applied_at, "申請日:" %></strong>
      </div>
      <div class="col-md-9 mb-3">
        <%= f.date_field :applied_at, class: "form-control" %>
      </div>

      <div class="col-md-3 text-end text-primary mb-3">
        <strong><%= f.label :category_id, "カテゴリ:" %></strong>
      </div>
      <div class="col-md-9 mb-3">
        <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "選択してください" }, { class: "form-control" } %>
      </div>

      <div class="col-md-3 text-end text-primary mb-3">
        <strong><%= f.label :vendor, "購入先:" %></strong>
      </div>
      <div class="col-md-9 mb-3">
        <%= f.text_field :vendor, class: "form-control" %>
      </div>

      <div class="col-md-3 text-end text-primary mb-3">
        <strong><%= f.label :unit_price_excl_tax, "税抜単価:" %></strong>
      </div>
      <div class="col-md-9 mb-3">
        <%= f.number_field :unit_price_excl_tax, class: "form-control" %>
      </div>

      <div class="col-md-3 text-end text-primary mb-3">
        <strong><%= f.label :quantity, "数量:" %></strong>
      </div>
      <div class="col-md-9 mb-3">
        <%= f.number_field :quantity, class: "form-control" %>
      </div>

      <div class="col-md-3 text-end text-primary mb-3">
        <strong><%= f.label :tax_rate, "消費税率 (%):" %></strong>
      </div>
      <div class="col-md-9 mb-3">
        <%= f.select :tax_rate, [["10%", 10], ["8%", 8]], { prompt: "選択してください" }, { class: "form-control" } %>
      </div>
            
      <div class="col-md-3 text-end text-primary mb-4">
        <strong>領収書・レシート:</strong>
      </div>
      <div class="col-md-9 mb-4">
        <%= f.file_field :image, accept: "image/*", class: "form-control" %>
      </div>

      <%= f.hidden_field :status, value: "申請中" %>

      <div class="col-md-3"></div>
      <div class="col-md-9 mt-3">  
        <%= f.submit "申請を提出する", class: "btn btn-primary" %>
        <%= link_to "戻る", root_path, class: "btn btn-outline-secondary" %>
      </div>

    </div>
  <% end %>

</div>

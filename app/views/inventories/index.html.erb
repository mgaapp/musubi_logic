<div class="container">

  <div class="row">
    <div class="col-md-12">
      <h2>【一般社員用】貯蔵品棚卸一覧</h2>
      <p class="text-muted">ここでは、一般社員の皆さんが貯蔵品の在庫を探したり、確認したりできます。</p>
    </div>
  </div>

  <div class="row mb-3">
    <div class="col-md-3 text-end text-primary fw-bold pt-1">
      在庫の検索:
    </div>
    <div class="col-md-9">
      <%= form_with url: inventories_path, method: :get, local: true do |f| %>
        <div class="input-group">
          <%= f.text_field :keyword, value: params[:keyword], placeholder: "品名、購入先、拠点で検索...", class: "form-control" %>
          <%= f.submit "検索", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-3 text-end text-primary fw-bold">
      メニュー操作:
    </div>
    <div class="col-md-9">
      <%= link_to "メニューに戻る", root_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <hr>

  <div class="row">
    <div class="col-md-12">
        <table class="table table-bordered"> 
          <thead class="table-light text-center">
            <tr>
              <th class="text-center text-nowrap">品名</th>
              <th class="text-center text-nowrap">保管場所</th>
              <th class="text-center text-nowrap">購入先</th>
              <th class="text-center text-nowrap">単価 (税抜)</th>
              <th class="text-center text-nowrap">在庫数</th>
              <th class="text-center text-nowrap">購入日</th>
              <th class="text-center text-nowrap">ステータス</th>
            </tr>
          </thead>
          
          <tbody class="text-center">
            <% @inventories.each do |inventory| %>
              <tr>
              <td class="text-center">
              <% if inventory.request.present? %>
                <span><%= inventory.request.category&.name %></span>
              <% else %>
                <span class="text-muted">-</span>
              <% end %>
            </td>
                 <td class="text-center"><%= inventory.location %></td>
                 <td class="text-center"><%= inventory.vendor %></td>
                <td class="text-center text-nowrap"><%= number_to_currency(inventory.unit_price_excl_tax, unit: "円", format: "%n%u", precision: 0) %></td>
                <td class="text-center"><%= inventory.stock_quantity %> 個</td>
                <td class="text-center text-nowrap"><%= inventory.purchase_date %></td>

               <td class="text-center">
                <% if inventory.stock_quantity.to_i > 0 %>
                    <span class="badge bg-success">在庫あり</span>
                  <% else %>
                    <span class="badge bg-secondary text-white">在庫なし</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<div class="backoffice-card">
  <h1 class="backoffice-title-general">マイプロフィール（一般社員画面）</h1>

  <div class="profile-group">
    <strong class="profile-label">氏名:</strong>
    <span class="profile-value"><%= @user.name %></span>
  </div>

  <div class="profile-group">
    <strong class="profile-label">社員番号:</strong>
    <span class="profile-value"><%= @user.employee_number %></span>
  </div>

  <div class="profile-group">
    <strong class="profile-label">メールアドレス:</strong>
    <span class="profile-value"><%= @user.email_address %></span>
  </div>
</div>
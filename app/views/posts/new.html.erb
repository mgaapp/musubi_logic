<div>
  <h2>💡 新しい知見・Q&Aの投稿</h2>
  <p>管理部門への確認結果や、共有したい申請ルールを入力してください。</p>

  <%= form_with model: @post do |form| %>
    
    <div>
      <%= form.label :title, "タイトル（質問やテーマ）" %>
      <%= form.text_field :title, placeholder: "例：10万円以上のパソコンの処理について", required: true %>
    </div>

    <div>
      <%= form.label :content, "内容（質問と回答の本文）" %>
      <%= form.text_area :content, placeholder: "例：【質問】〜〜ですか？\n【回答】〜〜として処理してください。", required: true %>
    </div>

    <div>
      <%= form.submit "知見を登録する" %>
      <%= link_to "キャンセルして戻る", posts_path %>
    </div>

  <% end %>
</div>
<div>
  <h2>新しい質問を投稿する</h2>
  <p>業務の中で分からないことがあれば、ここに質問を投稿してみましょう！</p>

  <%= form_with model: @post do |form| %>
    
    <div>
      <%= form.label :title, "タイトル（質問やテーマ）" %>
      <%= form.text_field :title, placeholder: "例：10万円以上のパソコンの処理について", required: true %>
    </div>

    <div>
      <%= form.label :content, "質問・知見の内容" %>
      <%= form.text_area :content, placeholder: "例：【質問】〜〜ですか？", required: true %>
    </div>

    <div>
      <%= form.submit "質問を投稿する" %>
      <%= link_to "キャンセルして戻る", posts_path %>
    </div>

  <% end %>
</div>
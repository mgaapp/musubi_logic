<div class="container">

  <div class="row">
    <div class="col-md-12">
      <h2>新しい質問を投稿する</h2>
      <p>業務の中で分からないことがあれば、ここに質問を投稿してみましょう。</p>
    </div>
  </div>

  <hr class="mb-4">

  <div class="row">
    <div class="col-md-8">
      <%= form_with model: @post, local: true do |form| %>

        <div class="mb-4">
          <%= form.label :title, "質問やテーマ", class: "form-label fw-bold" %>
          <%= form.text_field :title, placeholder: "例：10万円以上のパソコンの処理について", required: true, class: "form-control" %>
        </div>

        <div class="mb-4">
          <%= form.label :content, "質問の内容", class: "form-label fw-bold" %>
          <%= form.text_area :content, rows: 6, placeholder: "例：【質問】〜〜ですか？", required: true, class: "form-control" %>
        </div>

        <div class="d-flex align-items-center gap-3">
          <%= form.submit "質問を投稿する", class: "btn btn-primary" %>
          <%= link_to "キャンセルして戻る", posts_path, class: "btn btn-outline-secondary" %>
        </div>

      <% end %>
    </div>
  </div>

</div>

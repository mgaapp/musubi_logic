<div class="container">
  
  <div class="row mb-4">
    <div class="col-md-12">
      <h2>申請ルールのQ&Aの共有</h2>
      <p>過去の質問と回答をここで確認できます。</p>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-3 text-end text-primary">
      <strong>メニュー操作:</strong>
    </div>
    <div class="col-md-9">
      <%= link_to "新しく質問する", new_post_path, class: "btn btn-primary" %>
      <%= link_to "メニューに戻る", root_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-3 text-end text-primary">
      <strong>キーワードで検索:</strong>
    </div>
    <div class="col-md-9">
      <%= form_with url: posts_path, method: :get do |form| %>
        <div class="mb-2">
          <%= form.text_field :search, value: params[:search], placeholder: "キーワードを入力...", class: "form-control" %>
        </div>
        <%= form.submit "検索", class: "btn btn-dark" %>
      <% end %>
      
      <div class="mt-2 small">
        <%= link_to "全て", posts_path(search: params[:search]) %>
        <%= link_to "未回答のみ", posts_path(filter: "unanswered", search: params[:search]) %>
        <%= link_to "回答済みのみ", posts_path(filter: "answered", search: params[:search]) %>
      </div>
    </div>
  </div>

  <hr>

  <% @posts.each do |post| %>
    <div class="row">
     <div class="col-md-3 text-end text-primary">
        <strong>質問タイトル:</strong>
      </div>
      <div class="col-md-9">
        <h4 class="fw-bold"><%= post.title %></h4>
      </div>

      <div class="col-md-3 text-end text-primary">
        <strong>質問内容:</strong>
      </div>
      <div class="col-md-9">
        <p><%= post.content %></p>
      </div>

      <div class="col-md-3 text-end text-primary">
        <strong>公式回答:</strong>
      </div>
      <div class="col-md-9">
        <% if post.answer.present? && post.is_public? %>
          <p class="text-success fw-bold"><%= post.answer %></p>
        <% else %>
          <span class="badge bg-secondary">回答待ち</span>
        <% end %>
      </div>

      <% if Current.user&.admin? %>
        <div class="col-md-3 text-end text-primary">
          <strong>【管理者】回答入力:</strong>
        </div>
        <div class="col-md-9">
          <%= form_with model: post do |form| %>
            <div>
              <%= form.text_area :answer, placeholder: "ここに公式回答を入力してください...", class: "form-control" %>
            </div>

            <div class="mb-2">
              <%= form.check_box :is_public, id: "public_check_#{post.id}" %>
              <%= form.label :is_public, "この公式回答を一般社員に公開する", for: "public_check_#{post.id}" %>
            </div>

            <%= form.submit "回答を保存する", class: "btn btn-success" %>
          <% end %>
        </div>
      <% end %>

<div class="col-md-12">
  <hr>
  <div>
  <% end %>
  
  <div class="row">
    <div>
      <%= paginate @posts %>
    </div>
  </div>

</div>

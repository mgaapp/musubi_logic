<div class="container my-5">
 <div class="mb-4">
  <%= link_to "メニューに戻る", root_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <h2>申請ルールの知見共有（Q&A一覧）</h2>
  <p class="text-muted">過去の質問と回答をここで確認できます。</p>

  <div class="mb-4">
    <%= link_to "新しく質問する", new_post_path, class: "btn btn-primary btn-sm" %>
  </div>

  <hr>

  <div class="mb-4 p-3 bg-light rounded">
    <h5>キーワードで検索</h5>
    <%= form_with url: posts_path, method: :get, class: "d-flex gap-2" do |form| %>
      <%= form.text_field :search, value: params[:search], placeholder: "キーワードを入力...", class: "form-control" %>
      <%= form.submit "検索", class: "btn btn-dark" %>
    <% end %>
    
    <div class="mt-2 small">
      <%= link_to "全て", posts_path(search: params[:search]), class: "me-3" %>
      <%= link_to "未回答のみ", posts_path(filter: "unanswered", search: params[:search]), class: "me-3" %>
      <%= link_to "回答済みのみ", posts_path(filter: "answered", search: params[:search]) %>
    </div>
  </div>

  <div>
    <% @posts.each do |post| %>
      <div class="border p-4 mb-3 rounded bg-white">
        
        <h4 class="text-primary fw-bold"><%= post.title %></h4>
        <p class="text-secondary"><%= post.content %></p>

        <% if post.answer.present? && post.is_public? %>
          <div class="p-3 bg-success bg-opacity-10 rounded border border-success">
            <strong class="text-success">公式回答</strong>
            <p class="mt-2 mb-0"><%= post.answer %></p>
          </div>
        <% else %>
          <p class="text-muted small">※ まだ公式回答はありません。</p>
        <% end %>

        <% if Current.user&.admin? %>
          <div class="mt-3 p-3 bg-warning bg-opacity-10 rounded border border-warning">
            <p class="fw-bold text-warning-emphasis">管理者専用：公式回答を入力・編集</p>

            <%= form_with model: post do |form| %>
              <div class="mb-2">
                <%= form.text_area :answer, placeholder: "ここに公式回答を入力してください...", class: "form-control" %>
              </div>

              <div class="mb-2 form-check">
                <%= form.check_box :is_public, class: "form-check-input", id: "public_check_#{post.id}" %>
                <%= form.label :is_public, "この公式回答を一般社員に公開する", class: "form-check-label small text-muted", for: "public_check_#{post.id}" %>
              </div>

              <%= form.submit "回答を保存する", class: "btn btn-success btn-sm" %>
            <% end %>
          </div>
        <% end %>

      </div>
    <% end %>
  </div>
  
  <div class="d-flex justify-content-center mt-4">
    <%= paginate @posts %>
  </div>

</div>

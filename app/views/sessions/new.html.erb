<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-5">

      <div class="text-center">
        <h2 class="fw-bold">サインイン</h2>
        <p class="text-muted small">Musubi Logicをご利用のメールアドレスとパスワードを入力してください。</p>
      </div>

      <% if flash[:alert] %>
        <div class="alert alert-danger text-center" role="alert">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="alert alert-success text-center" role="alert">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= form_with url: session_path, local: true do |form| %>
        
        <div class="mb-3">
          <%= form.label :email_address, "メールアドレス", class: "form-label fw-bold" %>
          <%= form.email_field :email_address,
                               required: true,
                               autofocus: true,
                               autocomplete: "username",
                               placeholder: "example@musubi-logic.com",
                               value: params[:email_address],
                               class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= form.label :password, "パスワード", class: "form-label fw-bold" %>
          <%= form.password_field :password,
                                  required: true,
                                  autocomplete: "current-password",
                                  placeholder: "パスワードを入力してください",
                                  maxlength: 72,
                                  class: "form-control" %>
        </div>
        
        <div class="text-end mb-4">
          <%= link_to "パスワードをお忘れですか？", new_password_path, class: "text-muted small text-decoration-none" %>
        </div>

        <div class="d-grid">
          <%= form.submit "サインインする", class: "btn btn-primary fw-bold py-2" %>
        </div>

      <% end %>

    </div>
  </div>
</div>

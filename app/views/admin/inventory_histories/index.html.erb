<div class="container">

  <div class="row">
    <div class="col-md-12">
      <h2>全社員の入出庫履歴一覧</h2>
      <p>システム内で行われた、貯蔵品のすべての出庫・手動調整の履歴です。</p>
    </div>
  </div>

  <div class="row">
    <div class="col-md-3 text-end text-primary">
      <strong>メニュー操作:</strong>
    </div>
    <div class="col-md-9">
      <%= link_to "管理者メニューへ戻る", root_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <hr>

  <div class="row">
    <div class="col-md-12">
      <table class="table table-bordered align-middle">
        
        <thead class="table-light">
          <tr>
            <th class="text-center">日時</th>
            <th class="text-center">社員名</th>
            <th class="text-center">貯蔵品名（カテゴリ）</th>
            <th class="text-center">数量</th>
            <th class="text-center">区分</th>
          </tr>
        </thead>
        
        <tbody>
          <% @inventory_histories.each do |history| %>
            <tr  class="text-center">
              <td><%= history.created_at.strftime("%Y/%m/%d %H:%M") %></td>
              
              <td><%= history.user&.name %></td>
              
             <td><%= history.inventory&.vendor %> <span class="text-muted">(<%= history.inventory&.request&.category&.name %>)</span></td>
              
              <td><%= history.quantity %> 個</td>
              
              <td>
                <% if history.status == "out" %>
                  <span class="text-danger fw-bold">出庫</span>
                <% elsif history.status == "fix" %>
                  <span class="text-warning fw-bold">手動調整</span>
                <% else %>
                  <span><%= history.status %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>

      </table>
    </div>
  </div>
   <div class="row mt-3">
    <div class="d-flex justify-content-center">
      <%= paginate @inventory_histories %>
    </div>
  </div>
</div>

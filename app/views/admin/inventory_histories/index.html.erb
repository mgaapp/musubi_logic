<div>
  <h2>全社員の入出庫履歴一覧</h2>

  <table>
    <thead>
      <tr>
        <th>日時</th>
        <th>社員名</th> <th>貯蔵品名</th>
        <th>数量</th>
        <th>区分</th>
      </tr>
    </thead>
    <tbody>
      <% @inventory_histories.each do |history| %>
        <tr>
          <td><%= history.created_at.strftime("%Y/%m/%d %H:%M") %></td>
          
          <td><%= history.user.name %></td>
          
          <td><%= history.inventory.name %></td>
          
          <td><%= history.quantity %></td>
          
          <td>
            <% if history.status == "out" %>
              出庫
            <% elsif history.status == "fix" %>
              手動調整
            <% else %>
              <%= history.status %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
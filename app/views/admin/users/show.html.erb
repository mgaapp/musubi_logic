<div>
    <h1>社員詳細情報</h1>
    <%= link_to "一覧に戻る", admin_users_path %>
  </div>

  <div>
    <span>氏名:</span>
    <span><%= @user.name %></span>
  </div>

  <div>
    <span>社員番号:</span>
    <span><%= @user.employee_number %></span>
  </div>

  <div>
    <span>メールアドレス:</span>
    <span><%= @user.email_address %></span>
  </div>

  <div>
    <span>権限:</span>
    <span><%= @user.role == 'admin' ? '管理者' : '一般社員' %></span>
  </div>

  <div>
    <%= link_to "編集する", edit_admin_user_path(@user) %>
    
    <% if @user != Current.user %>
      <%= link_to "削除する", admin_user_path(@user), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn-action btn-action-delete" %>
    <% end %>
  </div>
</div>
<div class="backoffice-card">
  <h1 class="backoffice-title-general">新規社員登録</h1>

  <%= form_with model: [:admin, @user], url: admin_users_path(@user) do |f| %>
    
    <% # エラーメッセージがある場合に表示するエリア %>
    <% if @user.errors.any? %>
      <div class="error-messages">
        <h4>入力内容にエラーがあります：</h4>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="profile-group">
     <%= f.label :name, "氏名", class: "profile-label" %>
     <%= f.text_field :name, class: "form-control" %>
    </div>

    <div class="profile-group">
      <%= f.label :employee_number, "社員番号", class: "profile-label" %>
      <%= f.text_field :employee_number, class: "form-control" %>
    </div>

    <div class="profile-group">
      <%= f.label :email_address, "メールアドレス", class: "profile-label" %>
      <%= f.email_field :email_address, class: "form-control" %>
    </div>

    <div class="profile-group">
      <%= f.label :role, "権限", class: "profile-label" %>
      <%= f.select :role, [["一般社員", "general"], ["管理者", "admin"]], {}, class: "form-control" %>
    </div>

    <div class="profile-group">
      <%= f.label :password, "パスワード", class: "profile-label" %>
      <%= f.password_field :password, class: "form-control" %>
    </div>

    <div class="profile-group">
      <%= f.label :password_confirmation, "パスワード（確認用）", class: "profile-label" %>
      <%= f.password_field :password_confirmation, class: "form-control" %>
    </div>

    <div class="form-actions">
      <%= f.submit "登録する", class: "btn-submit" %>
      <%= link_to "戻る", admin_users_path, class: "link-back" %>
    </div>
  <% end %>
</div>
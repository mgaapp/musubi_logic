<div class="container">

  <div class="row">
    <div class="col-md-12">
      <h2>社員アカウント管理</h2>
      <p class="text-muted">社内のすべての社員アカウントの一覧です。新規登録や情報の確認・変更ができます。</p>
    </div>
  </div>

  <div class="row">
    <div class="col-md-3 text-end text-primary">
      <strong>メニュー操作:</strong>
    </div>
    <div class="col-md-9">
      <%= link_to "新規社員登録", new_admin_user_path, class: "btn btn-primary" %>
      <%= link_to "管理者メニューへ戻る", root_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <hr>

  <div class="row">
    <div class="col-md-12">
      <table class="table table-bordered">
        
        <thead class="table-light">
          <tr>
            <th class="text-center">社員番号</th>
             <th class="text-center">名前</th>
             <th class="text-center">所属拠点</th>
             <th class="text-center">メールアドレス</th>
             <th class="text-center">権限</th>
             <th class="text-center">操作</th>
          </tr>
        </thead>
        
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td class="text-center"><%= user.employee_number %></td>
              
              <td class="text-center">
                <%= link_to user.name, admin_user_path(user) %>
              </td>
              
              <td class="text-center"><%= user.location.presence || "—" %></td>
              
              <td class="text-center"><%= user.email_address %></td>
              
              <td class="text-center">
                <% if user.role == "admin" || user.role == "管理者" %>
                  <span class="badge bg-danger">管理者</span>
                <% else %>
                  <span class="badge bg-secondary">一般社員</span>
                <% end %>
              </td>
              
              <td class="text-center">
                <%= link_to "詳細", admin_user_path(user), class: "btn btn-outline-primary" %>
              </td>
            </tr>
          <% end %>
        </tbody>

      </table>
    </div>
  </div>

</div>
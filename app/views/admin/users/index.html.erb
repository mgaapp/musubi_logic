<div class="container">
  <div class="header">
    <h1 class="title">社員登録一覧</h1>
    <span class="admin-badge">ADMIN</span>
  </div>

  <table class="user-table">
    <thead>
      <tr class="table-header-row">
        <th class="table-header-cell">社員番号</th>
        <th class="table-header-cell">名前</th>
        <th class="table-header-cell">メールアドレス</th>
        <th class="table-header-cell">権限（Role）</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr class="table-row">
          <td class="table-cell employee-number"><%= user.employee_number %></td>
          <td class="table-cell"><%= user.name %></td>
          <td class="table-cell email"><%= user.email_address %></td>
          <td class="table-cell role"><%= user.role %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div>
  <h1>社員情報の編集</h1>

  <%= form_with model: [:admin, @user] do |f| %>
    
    <% if @user.errors.any? %>
      <div class="error-messages">
        <h4>入力内容にエラーがあります：</h4>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "氏名" %>
      <%= f.text_field :name %>
    </div>

    <div>
      <%= f.label :employee_number, "社員番号" %>
      <%= f.text_field :employee_number %>
    </div>

    <div>
      <%= f.label :email_address, "メールアドレス" %>
      <%= f.email_field :email_address, class: "form-control" %>
    </div>

    <div>
      <%= f.label :role, "権限" %>
      <%= f.select :role, [["一般社員", "general"], ["管理者", "admin"]], {}, class: "form-control" %>
    </div>

    <div>
      <%= f.label :location, "所属拠点" %>
      <%= f.select :location, [["本社", "本社"], ["大阪支店", "大阪支店"]], {}, class: "form-control" %>
    </div>

      <div class="profile-group">
        <%= f.label :password, "新しいパスワード" %>
        <%= f.password_field :password %>
      </div>

      <div>
        <%= f.label :password_confirmation, "新しいパスワード（確認用）" %>
        <%= f.password_field :password_confirmation %>
      </div>
    </div>

    <div>
      <%= f.submit "変更を保存する" %>
      <%= link_to "戻る", admin_users_path %>
    </div>
  <% end %>
</div>
<div class="backoffice-card">
  <h1 class="backoffice-title-general">社員情報の編集</h1>

  <%= form_with model: [:admin, @user] do |f| %>
    
    <% if @user.errors.any? %>
      <div class="error-messages">
        <h4>入力内容にエラーがあります：</h4>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="profile-group">
      <%= f.label :name, "氏名", class: "profile-label" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>

    <div class="profile-group">
      <%= f.label :employee_number, "社員番号", class: "profile-label" %>
      <%= f.text_field :employee_number, class: "form-control" %>
    </div>

    <div class="profile-group">
      <%= f.label :email_address, "メールアドレス", class: "profile-label" %>
      <%= f.email_field :email_address, class: "form-control" %>
    </div>

    <div class="profile-group">
      <%= f.label :role, "権限", class: "profile-label" %>
      <%= f.select :role, [["一般社員", "general"], ["管理者", "admin"]], {}, class: "form-control" %>
    </div>

    <div style="background-color: #f8f9fa; padding: 15px; border-radius: 4px; margin-bottom: 15px;">
      <p style="margin: 0 0 10px 0; font-size: 13px; color: #666;">※パスワードを変更する場合のみ入力してください</p>
      <div class="profile-group">
        <%= f.label :password, "新しいパスワード", class: "profile-label" %>
        <%= f.password_field :password, class: "form-control" %>
      </div>

      <div class="profile-group">
        <%= f.label :password_confirmation, "新しいパスワード（確認用）", class: "profile-label" %>
        <%= f.password_field :password_confirmation, class: "form-control" %>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit "変更を保存する", class: "btn-submit" %>
      <%= link_to "戻る", admin_users_path, class: "link-back" %>
    </div>
  <% end %>
</div>
<div class="container">

  <div class="row">
    <div class="col-md-12">
      <h2>貯蔵品 在庫登録</h2>
    </div>
  </div>

  <div class="row">
    <div class="col-md-3 text-end text-primary">
      <strong>メニュー操作:</strong>
    </div>
    <div class="col-md-9">
      <%= link_to "在庫棚卸一覧に戻る", admin_inventories_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <hr>

  <%= form_with model: [:admin, @inventory] do |f| %>
    
    <div class="row mb-3 align-items-center">
      <div class="col-md-3 text-end text-primary fw-bold">
        <%= f.label :request_id, "申請ID:" %>
      </div>
      <div class="col-md-9">
        <%= f.number_field :request_id, class: "form-control" %>
      </div>
    </div>

    <div class="row mb-3 align-items-center">
      <div class="col-md-3 text-end text-primary fw-bold">
        <%= f.label :location, "拠点名:" %>
      </div>
      <div class="col-md-9">
        <%= f.text_field :location, placeholder: "東京本社、大阪支店など", class: "form-control" %>
      </div>
    </div>

    <div class="row mb-3 align-items-center">
      <div class="col-md-3 text-end text-primary fw-bold">
        <%= f.label :unit_price_excl_tax, "税抜単価:" %>
      </div>
      <div class="col-md-9">
        <%= f.number_field :unit_price_excl_tax, class: "form-control" %>
      </div>
    </div>

    <div class="row mb-3 align-items-center">
      <div class="col-md-3 text-end text-primary fw-bold">
        <%= f.label :stock_quantity, "個数:" %>
      </div>
      <div class="col-md-9">
        <%= f.number_field :stock_quantity, class: "form-control" %>
      </div>
    </div>

    <div class="row mb-3 align-items-center">
      <div class="col-md-3 text-end text-primary fw-bold">
        <%= f.label :vendor, "購入先:" %>
      </div>
      <div class="col-md-9">
        <%= f.text_field :vendor, class: "form-control" %>
      </div>
    </div>

    <div class="row mb-3 align-items-center">
      <div class="col-md-3 text-end text-primary fw-bold">
        <%= f.label :purchase_date, "購入日:" %>
      </div>
      <div class="col-md-9">
        <%= f.date_field :purchase_date, class: "form-control" %>
      </div>
    </div>

    <div class="row mb-4 align-items-center">
      <div class="col-md-3 text-end text-primary fw-bold">
        <%= f.label :status, "入出庫ステータス:" %>
      </div>
      <div class="col-md-9">
        <%= f.select :status, [["入庫済", "in_stock"], ["出庫済", "out_of_stock"]], {}, class: "form-select" %>
      </div>
    </div>

    <div class="row">
      <div class="col-md-9 offset-md-3">
        <%= f.submit "貯蔵品を登録する", class: "btn btn-primary" %>
      </div>
    </div>

  <% end %>

</div>

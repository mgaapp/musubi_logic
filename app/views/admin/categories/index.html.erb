<div class="container">

  <div class="row">
    <div class="col-md-12">
      <h2>勘定科目・カテゴリ一覧</h2>
      <p class="text-muted">現在、システムに登録されているカテゴリと勘定科目の組み合わせ一覧です。</p>
    </div>
  </div>

  <div class="row">
    <div class="col-md-3 text-end text-primary">
      <strong>メニュー操作:</strong>
    </div>
    <div class="col-md-9">
      <%= link_to "新規登録画面へ", new_admin_category_path, class: "btn btn-primary" %>
      <%= link_to "管理者メニューへ戻る", root_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <hr>

  <div class="row">
    <div class="col-md-12">
      <table class="table table-bordered align-middle">

        <thead class="table-light">
          <tr>
            <th class="text-center">ID</th>
            <th class="text-center">カテゴリ名（品名）</th>
            <th class="text-center">対応する勘定科目</th>
            <th class="text-center">登録日</th>
          </tr>
        </thead>

        <tbody>
          <% @categories.each do |category| %>
            <tr>
              <td class="text-center"><%= category.id %></td>
              <td class="text-center"><%= category.name %></td>
              <td class="text-center">
                <% if category.account_item == "貯蔵品" %>
                  <span class="text-warning">貯蔵品（在庫連動）</span>
                <% else %>
                  <span class="text-secondary"><%= category.account_item %></span>
                <% end %>
              </td>
              <td class="text-center"><%= category.created_at.strftime("%Y-%m-%d") %></td>
            </tr>
          <% end %>
        </tbody>

      </table>
    </div>
  </div>

</div>

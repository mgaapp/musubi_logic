<div class="container mt-4">
    <h2>勘定科目・カテゴリ一覧</h2>
    <%= link_to "新規登録画面へ", new_admin_category_path, class: "btn btn-primary" %>
  </div>

  <p class="text-muted">現在、システムに登録されているカテゴリと勘定科目の組み合わせです。</p>

  <table class="table table-striped table-bordered">
    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>カテゴリ名（品名）</th>
        <th>対応する勘定科目</th>
        <th>登録日</th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><%= category.id %></td>
          <td><strong><%= category.name %></strong></td>
          <td>
            <% if category.account_item == "貯蔵品" %>
              <span class="badge bg-warning text-dark">貯蔵品（在庫連動）</span>
            <% else %>
              <span class="badge bg-secondary"><%= category.account_item %></span>
            <% end %>
          </td>
          <td><%= category.created_at.strftime("%Y-%m-%d") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= link_to "管理者メニューへ戻る", admin_requests_path, class: "btn btn-outline-secondary" %>
</div>
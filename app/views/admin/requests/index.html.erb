<div class="container my-5">
 <div class="mb-4">
  <%= link_to "メニューに戻る", root_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <h2>【管理者用】経費申請・精査一覧</h2>
  <p class="text-muted">社内のすべての社員から提出された申請が集まっています。内容を確認して「精査（承認・差戻し）」を行ってください。</p>

  <hr>
  
  <div class="filter-box" style="margin-bottom: 20px;">
  <span>【ステータスで絞り込み】：</span>
  <%= link_to "すべて", admin_requests_path, class: "btn-all" %> |
  <%= link_to "申請中", admin_requests_path(status: "申請中"), class: "btn-filter" %> |
  <%= link_to "承認済み", admin_requests_path(status: "承認済み"), class: "btn-filter" %> |
  <%= link_to "差戻し", admin_requests_path(status: "差戻し"), class: "btn-filter" %>
  </div>

  <div class="border rounded bg-white p-3 mb-4">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        
        <thead class="table-light">
          <tr>
            <th class="py-2 px-3 text-secondary small">申請者</th>
            <th class="py-2 text-secondary small">申請日</th>
            <th class="py-2 text-secondary small">勘定科目</th>
            <th class="py-2 text-secondary small">税込金額</th>
            <th class="py-2 text-secondary small">ステータス</th>
            <th class="py-2 text-center text-secondary small">精査</th>
          </tr>
        </thead>
        
        <tbody>
          <% @requests.each do |request| %>
            <tr>
              <td class="px-3 fw-bold text-dark">
                <%= request.user.name if request.user %>
              </td>

              <td class="text-secondary small">
                <%= request.applied_at %>
              </td>

              <td class="text-dark">
                <% if request.category %>
                  <%= request.category.account_item %>
                  <span class="text-muted small">(<%= request.category.name %>)</span>
                <% end %>
              </td>

              <td class="fw-bold text-dark">
                <%= number_to_currency(request.total_amount_incl_tax, unit: "円", format: "%n %u", precision: 0) %>
              </td>

              <td>
                <% if request.status == "approved" || request.status == "承認" || request.status == "承認済み" %>
                  <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1.5 rounded small">承認済み</span>
                <% elsif request.status == "rejected" || request.status == "差戻し" %>
                  <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1.5 rounded small">差戻し</span>
                <% else %>
                  <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning px-2 py-1.5 rounded small">申請中</span>
                <% end %>
              </td>
   
              <td class="text-center">
                <%= link_to "精査する", admin_request_path(request), class: "btn btn-outline-primary btn-sm px-3" %>
              </td>
            </tr>
          <% end %>
        </tbody>

      </table>
    </div>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @requests %>
  </div>

</div>
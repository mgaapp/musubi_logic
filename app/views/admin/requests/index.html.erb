<div class="container">

  <div class="row">
    <div class="col-md-12">
      <h2>【管理者用】経費申請・精査一覧</h2>
      <p class="text-muted">全社員から提出された申請一覧です。</p>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-3 text-end text-primary">
      <strong>メニュー操作:</strong>
    </div>
    <div class="col-md-9">
      <%= link_to "管理者メニューへ戻る", root_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-3 text-end text-primary">
      <strong>ステータスで絞り込み:</strong>
    </div>
    <div class="col-md-9">
      <%= link_to "すべて", admin_requests_path, class: "btn btn-sm btn-outline-dark" %>
      <%= link_to "申請中", admin_requests_path(status: "申請中"), class: "btn btn-sm btn-outline-warning" %>
      <%= link_to "承認済み", admin_requests_path(status: "承認済み"), class: "btn btn-sm btn-outline-success" %>
      <%= link_to "差戻し", admin_requests_path(status: "差戻し"), class: "btn btn-sm btn-outline-danger" %>
    </div>
  </div>

  <hr>

  <div class="row">
    <div class="col-md-12">
      <table class="table table-bordered align-middle">
        
        <thead class="table-light">
          <tr>
            <th class="text-center">申請者</th>
            <th class="text-center">申請日</th>
            <th class="text-center">勘定科目</th>
            <th class="text-center">税込金額</th>
            <th class="text-center">ステータス</th>
            <th class="text-center">精査</th>
          </tr>
        </thead>
        
        <tbody>
          <% @requests.each do |request| %>
            <tr>
              <td class="text-center"><%= request.user&.name %></td>
              <td class="text-center"><%= request.applied_at %></td>
              <td>
                <% if request.category %>
                  <%= request.category.account_item %>
                  <span  class="text-center">(<%= request.category.name %>)</span>
                <% end %>
              </td>
              <td  class="text-center">
                <%= number_to_currency(request.total_amount_incl_tax, unit: "円", format: "%n %u", precision: 0) %>
              </td>
              <td>
                <% if request.status == "approved" || request.status == "承認" || request.status == "承認済み" %>
                  <span class="text-success fw-bold">承認済み</span>
                <% elsif request.status == "rejected" || request.status == "差戻し" %>
                  <span class="text-danger fw-bold">差戻し</span>
                <% else %>
                  <span class="text-warning fw-bold">申請中</span>
                <% end %>
              </td>
              <td class="text-center">
                <%= link_to "精査する", admin_request_path(request), class: "btn btn-primary" %>
              </td>
            </tr>
          <% end %>
        </tbody>

      </table>
    </div>
  </div>

  <div class="row">
    <div class="col-md-9 offset-md-3">
      <%= paginate @requests %>
    </div>
  </div>

</div>

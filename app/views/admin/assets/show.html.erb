<div class="container">

  <div class="row">
    <div class="col-md-12">
      <h2>固定資産 詳細情報</h2>
    </div>
  </div>

  <div class="row">
    <div class="col-md-3 text-end text-primary">
      <strong>メニュー操作:</strong>
    </div>
    <div class="col-md-9">
      <%= link_to "一覧に戻る", admin_assets_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <hr>

  <div class="row">

    <div class="col-md-3 text-end text-primary  mb-3">
      <strong>資産ID:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.id %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>拠点名:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.location %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>取得金額（税抜）:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= number_to_currency(@asset.acquisition_cost_excl, unit: "円", format: "%n %u", precision: 0) %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>耐用年数:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.useful_life_years %> 年
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>償却方法:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.depreciation_method %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>供用開始日:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.service_start_date %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>購入先:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.vendor %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>購入日:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.purchase_date %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>償却終了予定日:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.depreciation_end_date ? @asset.depreciation_end_date : "未定" %>
    </div>

    <div class="col-md-3 text-end text-primary">
      <strong>状態:</strong>
    </div>
    <div class="col-md-9 fw-bold">
      <%= @asset.status %>
    </div>

  </div>
</div>

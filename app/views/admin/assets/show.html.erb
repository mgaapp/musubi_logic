<div class="container">

  <div class="row">
    <div class="col-md-12">
      <h2>固定資産 詳細情報</h2>
    </div>
  </div>

  <div class="row">
    <div class="col-md-3 text-end text-primary">
      <strong>メニュー操作:</strong>
    </div>
    <div class="col-md-9">
      <%= link_to "一覧に戻る", admin_assets_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <hr>

  <div class="row">

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>資産ID:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.id %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>品名:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.request&.category&.name %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>拠点名:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.location %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>取得金額（税抜）:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= number_to_currency(@asset.acquisition_cost_excl, unit: "円", format: "%n %u", precision: 0) %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>耐用年数:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.useful_life_years %> 年
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>償却方法:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.depreciation_method %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>供用開始日:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.service_start_date %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>購入先:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.vendor %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>購入日:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.purchase_date %>
    </div>

    <div class="col-md-3 text-end text-primary mb-3">
      <strong>償却終了予定日:</strong>
    </div>
    <div class="col-md-9 mb-3">
      <%= @asset.depreciation_end_date ? @asset.depreciation_end_date : "未定" %>
    </div>

    <div class="col-md-3 text-end text-primary">
      <strong>状態:</strong>
    </div>
    <div class="col-md-9 fw-bold">
      <%= @asset.status %>
    </div>

    <hr class="my-4">
    <h5 class="fw-bold text-primary mb-3">減価償却 計算シミュレーション（定額法）</h5>

    <div class="row">
      <% if @asset.useful_life_years.to_i > 0 && @asset.acquisition_cost_excl.to_i > 0 %>
        <% yearly_depreciation = @asset.acquisition_cost_excl.to_i / @asset.useful_life_years.to_i %>
        <div class="col-md-6 mb-2">
          <strong>1年間あたりの償却費:</strong> 
          <span class="text-danger fw-bold"><%= number_to_currency(yearly_depreciation, unit: "円", format: "%n %u", precision: 0) %></span> / 年
        </div>
        <div class="col-md-6">
          <strong>毎月の償却目安額:</strong> 
          <span><%= number_to_currency(yearly_depreciation / 12, unit: "円", format: "%n %u", precision: 0) %></span> / 月
        </div>
        <div class="col-md-12">
          <p class="small text-muted">※定額法に基づき、耐用年数期間で均等に費用化する計算に対応しています。</p>
        </div>
      <% else %>
        <div class="col-md-12 text-muted small">取得金額または耐用年数が設定されていないため、計算できません。</div>
      <% end %>
    </div>
  </div>

</div>

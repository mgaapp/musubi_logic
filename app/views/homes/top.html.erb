<% if authenticated? %>
  <div class="container"> 
    <div class="row mb-5">
      <div class="col-md-12">
        <h2><%= Current.user&.admin? ? "管理者メニュー" : "一般社員用メニュー" %></h2>
      </div>
    </div>

    <div class="row">

      <% if Current.user&.admin? %>
        <div class="row mb-4">
          <div class="col-md-3 text-end text-primary fw-bold fs-5">承認・精査:</div>
          <div class="col-md-9">
            <%= link_to "届いた経費申請を精査する", admin_requests_path, class: "btn btn-primary px-4" %>
          </div>
        </div>

        <div class="row align-items-center mb-4">
          <div class="col-md-3 text-end text-primary fw-bold fs-5">貯蔵品在庫管理:</div>
          <div class="col-md-9">
            <%= link_to "貯蔵品を探す・買う（棚卸一覧）", admin_inventories_path, class: "btn btn-primary px-4 py-2" %>
            <%= link_to "貯蔵品の入出庫・調整履歴を見る", admin_inventory_histories_path, class: "btn btn-outline-secondary px-4 py-2" %>
          </div>
        </div>

        <div class="row align-items-center mb-4">
          <div class="col-md-3 text-end text-primary fw-bold fs-5">資産管理:</div>
          <div class="col-md-9">
            <%= link_to "固定資産台帳（管理）", admin_assets_path, class: "btn btn-primary px-4 py-2" %>
          </div>
        </div>

        <div class="row align-items-center mb-4">
          <div class="col-md-3 text-end text-primary fw-bold fs-5">マスタ管理:</div>
          <div class="col-md-9">
            <%= link_to "勘定科目・カテゴリ一覧", admin_categories_path, class: "btn btn-primary px-4 py-2" %>
          </div>
        </div>

        <div class="row align-items-center mb-4">
          <div class="col-md-3 text-end text-primary fw-bold fs-5">社員管理:</div>
          <div class="col-md-9">
            <%= link_to "社員アカウントの管理", admin_users_path, class: "btn btn-primary px-4 py-2" %>
          </div>
        </div>

        <div class="row align-items-center mb-4">
          <div class="col-md-3 text-end text-primary fw-bold fs-5">Q&Aコミュニティ:</div>
          <div class="col-md-9">
            <%= link_to "Q&Aの回答・管理をする", posts_path, class: "btn btn-primary px-4 py-2 shadow-sm" %>
          </div>
        </div>
      <% else %> 
        <div class="row align-items-center mb-4">
          <div class="col-md-3 text-end text-primary fw-bold fs-5">経費精算:</div>
          <div class="col-md-9">
            <%= link_to "新しく経費申請をする", new_request_path, class: "btn btn-primary" %>
            <%= link_to "自分の申請履歴を見る", requests_path, class: "btn btn-outline-secondary" %>
          </div>
        </div>

        <div class="row align-items-center mb-4">
          <div class="col-md-3 text-end text-primary fw-bold fs-5">貯蔵品:</div>
          <div class="col-md-9">
            <%= link_to "貯蔵品を探す（棚卸一覧）", inventories_path, class: "btn btn-primary" %>
            <%= link_to "貯蔵品の入出庫履歴を見る", inventory_histories_path, class: "btn btn-outline-secondary px-4 py-2 ms-2" %>
          </div>
        </div>

        <div class="row align-items-center mb-4">
          <div class="col-md-3 text-end text-primary fw-bold fs-5">固定資産:</div>
          <div class="col-md-9">
            <%= link_to "固定資産一覧を見る", assets_path, class: "btn btn-primary" %>
          </div>
        </div>

        <div class="row align-items-center mb-4">
          <div class="col-md-3 text-end text-primary fw-bold fs-5">Q&Aコミュニティ:</div>
          <div class="col-md-9">
            <%= link_to "Q&Aを見る", posts_path, class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>

    </div> 
  </div>
<% else %>
<div class="container">
  <div class="p-5 mb-4 bg-light rounded-3">
    <h1 class="fw-bold text-primary">Musubi Logic</h1>
    <p class="text-muted">購入精算・貯蔵品管理・固定資産・社内ナレッジを繋ぐ、バックオフィス一元化プラットフォーム</p>

    <hr>

    <p class="fw-bold">【開発の背景】</p>
    <p>備品・消耗品の購入申請（精算）、貯蔵品の在庫管理、固定資産台帳、そして社内のFAQやナレッジが別々のツールやExcelで分断されている課題を解消するために生まれました。購入精算から貯蔵品への在庫反映、高額備品の資産化、現場からのQ&Aまでを一元管理し、事前確認による二重購入の抑止とバックオフィス精算業務の効率化を実現します。</p>
  </div>
  
  <div class="row">
    <div class="col-md-4">
      <h4 class="text-primary fw-bold">物品・在庫 ＆ 購入精算</h4>
      <p>消耗品やオフィス備品等の購入・立替精算をWeb上で完結。事前に社内在庫を確認できるため無駄な二重購入を防止でき、保管・管理が必要な貯蔵品は在庫データとして払出履歴まで追跡可能です。</p>
    </div>
    <div class="col-md-4">
      <h4 class="text-primary fw-bold">固定資産管理</h4>
      <p>備品購入時の経費精算に伴う「資産の登録漏れ」を防止。精算承認された高額物品をスムーズに固定資産として登録・一覧化し、保管場所や関連申請情報を可視化します。</p>
    </div>
    <div class="col-md-4">
      <h4 class="text-primary fw-bold">知見共有・社内Q＆A</h4>
      <p>「この購入金額は資産計上すべきか消耗品か」「領収書の精算ルールは？」といった、管理部門へ集中しがちな重複する問い合わせや各種手続きのノウハウを掲示板形式で蓄積・共有できます。</p>
    </div>
  </div>
</div>
<% end %>
